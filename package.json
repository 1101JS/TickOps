{
  "name": "tickops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/node.js",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "lan": "node --env-file-if-exists=.env server/node.js",
    "crear-admin": "node --env-file-if-exists=.env server/crear-admin.js",
    "instalar": "node --env-file-if-exists=.env server/instalar.js",
    "migrar": "node --env-file-if-exists=.env server/migrar.js",
    "actualizar": "node --env-file-if-exists=.env server/actualizar.js",
    "comprobar-esquema": "node --env-file-if-exists=.env server/comprobar-esquema.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/*.test.js\"",
    "respaldo": "node --env-file-if-exists=.env server/respaldo.js",
    "descifrar-respaldo": "node --env-file-if-exists=.env server/respaldo.js descifrar"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
