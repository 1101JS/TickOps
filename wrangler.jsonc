{
  "$schema": "https://unpkg.com/wrangler@4.165.0/config-schema.json",
  // IMPORTANTE: debe coincidir con el nombre del Worker que ya sirve tickops.bid en el dashboard de Cloudflare.
  "name": "eticket",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Frontend (Vue) compilado por "npm run build". Solo /api/* pasa por el Worker; el resto es estático.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Base de datos. Sin "database_id", wrangler la crea automáticamente en el primer deploy.
  // Si prefieres crearla a mano: npx wrangler d1 create tickops  y pega aquí el database_id.
  "d1_databases": [
    { "binding": "DB", "database_name": "tickops" }
  ],

  // Modo demostración en línea: siembra cuentas demo y usa un costo de hash apto para el plan gratuito.
  "vars": {
    "SEED_DEMO": "true",
    "ALLOW_REGISTRATION": "true",
    "PBKDF2_ITERATIONS": "20000"
  }
}
