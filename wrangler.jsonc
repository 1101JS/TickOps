{
  "$schema": "https://unpkg.com/wrangler@4.165.0/config-schema.json",
  // IMPORTANTE: debe coincidir con el nombre del Worker que ya sirve tickops.bid en el dashboard de Cloudflare.
  "name": "eticket",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Frontend (Vue) compilado por "npm run build". Solo /api/* pasa por el Worker; el resto es estático.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // La API corre en la PC (Node + PostgreSQL) y se publica con un túnel de Cloudflare.
  // El túnel solo deja pasar rutas /api/ (ver iniciar-tickops.bat y ~/.cloudflared/config.yml).
  "vars": {
    "API_ORIGIN": "https://origen.tickops.bid"
  }
}
